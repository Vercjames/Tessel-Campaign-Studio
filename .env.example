# Copy to .env.local and fill in.

# Required. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Extra prohibited words for the legal check, comma-separated (profanity is built in)
LEGAL_BLOCKLIST=

# Optional. Server-side deadline requested from Gemini per attempt, in milliseconds (default 120000)
GEMINI_TIMEOUT_MS=
